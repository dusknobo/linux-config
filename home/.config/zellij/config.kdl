// Direct Super shortcuts; ordinary Ctrl keys remain available to Neovim.
// Prefix: Ctrl+g. Double prefix sends a literal Ctrl+g to the application.
// No Alt bindings: Alt is the Niri compositor modifier on this laptop.
default_mode "locked"

keybinds clear-defaults=true {
    // Direct Windows/Super shortcuts, available in every Zellij mode.
    shared {
        bind "Super h" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "Super j" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "Super k" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "Super l" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "Super r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "Super d" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "Super n" { NewTab; SwitchToMode "Locked"; }
        bind "Super Tab" { GoToNextTab; SwitchToMode "Locked"; }
        bind "Super Shift Tab" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "Super f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    normal {
        bind "Ctrl g" { Write 7; SwitchToMode "Locked"; }
        bind "p" { SwitchToMode "Pane"; }
        bind "t" { SwitchToMode "Tab"; }
        bind "r" { SwitchToMode "Resize"; }
        bind "m" { SwitchToMode "Move"; }
        bind "s" { SwitchToMode "Scroll"; }
        bind "o" { SwitchToMode "Session"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
    }
    pane {
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Locked"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Locked"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Locked"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Locked"; }
        bind "p" { SwitchFocus; SwitchToMode "Locked"; }
        bind "n" { NewPane; SwitchToMode "Locked"; }
        bind "r" { NewPane "Right"; SwitchToMode "Locked"; }
        bind "d" { NewPane "Down"; SwitchToMode "Locked"; }
        bind "x" { CloseFocus; SwitchToMode "Locked"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Locked"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Locked"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
    }
    tab {
        bind "h" "k" "Left" "Up" { GoToPreviousTab; SwitchToMode "Locked"; }
        bind "l" "j" "Right" "Down" { GoToNextTab; SwitchToMode "Locked"; }
        bind "n" { NewTab; SwitchToMode "Locked"; }
        bind "x" { CloseTab; SwitchToMode "Locked"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "b" { BreakPane; SwitchToMode "Locked"; }
        bind "1" { GoToTab 1; SwitchToMode "Locked"; }
        bind "2" { GoToTab 2; SwitchToMode "Locked"; }
        bind "3" { GoToTab 3; SwitchToMode "Locked"; }
        bind "4" { GoToTab 4; SwitchToMode "Locked"; }
        bind "5" { GoToTab 5; SwitchToMode "Locked"; }
        bind "6" { GoToTab 6; SwitchToMode "Locked"; }
        bind "7" { GoToTab 7; SwitchToMode "Locked"; }
        bind "8" { GoToTab 8; SwitchToMode "Locked"; }
        bind "9" { GoToTab 9; SwitchToMode "Locked"; }
        bind "Tab" { ToggleTab; SwitchToMode "Locked"; }
    }
    resize {
        // Repeat these keys as needed; Esc or Enter returns to the application.
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    move {
        bind "h" "Left" { MovePane "Left"; SwitchToMode "Locked"; }
        bind "j" "Down" { MovePane "Down"; SwitchToMode "Locked"; }
        bind "k" "Up" { MovePane "Up"; SwitchToMode "Locked"; }
        bind "l" "Right" { MovePane "Right"; SwitchToMode "Locked"; }
    }
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "h" "Left" "PageUp" { PageScrollUp; }
        bind "l" "Right" "PageDown" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "s" "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Locked"; }
        bind "c" { Copy; ScrollToBottom; SwitchToMode "Locked"; }
    }
    entersearch {
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    search {
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    renamepane {
        bind "Esc" { UndoRenamePane; SwitchToMode "Locked"; }
        bind "Enter" { SwitchToMode "Locked"; }
    }
    renametab {
        bind "Esc" { UndoRenameTab; SwitchToMode "Locked"; }
        bind "Enter" { SwitchToMode "Locked"; }
    }
    session {
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }
            SwitchToMode "Locked"
        }
    }
    shared_among "normal" "pane" "tab" "resize" "move" "session" {
        bind "Esc" "Enter" { SwitchToMode "Locked"; }
    }
    shared_among "scroll" "search" {
        bind "Esc" "Enter" { ScrollToBottom; SwitchToMode "Locked"; }
    }
}
